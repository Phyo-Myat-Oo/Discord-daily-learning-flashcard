{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Learning Flashcard",
  "type": "object",
  "required": ["id", "stream", "language", "category", "topic", "difficulty", "example", "tags", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "stream": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "language": {"enum": ["my", "en", "bilingual"]},
    "sequence": {"type": "integer", "minimum": 1},
    "date": {"type": "string", "format": "date"},
    "category": {"enum": ["linux", "networking", "git", "docker", "python", "ai", "mlops", "ai-engineering", "neuroscience", "review"]},
    "topic": {"type": "string"},
    "concept_key": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
    "track": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "track_sequence": {"type": "integer", "minimum": 1},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "command": {"type": "string"},
    "explanation": {"type": "string"},
    "flags": {"type": "array", "items": {"type": "object", "required": ["flag"], "properties": {"flag": {"type": "string"}, "meaning": {"type": "string"}, "en": {"type": "string"}, "my": {"type": "string"}}}},
    "use_case": {"type": "string"},
    "example": {"type": "string"},
    "question": {"type": "string"},
    "answer": {"type": "string"},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["candidate", "approved", "rejected", "scheduled"]},
    "priority": {"enum": ["low", "normal", "high"]},
    "generated_from_source": {"type": "boolean"},
    "source_type": {"enum": ["pdf", "epub", "ipynb", "md", "txt", "py"]},
    "source_file": {"type": "string"},
    "source_title": {"type": "string"},
    "source_section": {"type": "string"},
    "source_page": {"type": "integer", "minimum": 1},
    "source_cell": {"type": "integer", "minimum": 0},
    "needs_review": {"type": "boolean"},
    "study_plan": {
      "type": "object",
      "required": ["course_day", "course_week", "study_duration_minutes", "source_id", "source_title", "source_locator", "tasks", "study_output"],
      "properties": {
        "course_day": {"type": "integer", "minimum": 1, "maximum": 182},
        "course_week": {"type": "integer", "minimum": 1, "maximum": 26},
        "study_duration_minutes": {"const": 60},
        "source_id": {"type": "string"},
        "source_title": {"type": "string"},
        "source_locator": {"type": "string"},
        "source_url": {"type": "string"},
        "online_resource": {
          "type": "object",
          "required": ["title", "url", "note"],
          "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "note": {"type": "string"}},
          "additionalProperties": false
        },
        "workload": {
          "type": "object",
          "required": ["estimated_reading_minutes", "raw_text_minutes", "density", "word_count", "equation_lines", "figure_table_refs", "code_lines"],
          "properties": {
            "estimated_reading_minutes": {"type": "integer", "minimum": 18, "maximum": 30},
            "raw_text_minutes": {"type": "number", "minimum": 0},
            "density": {"enum": ["low", "medium", "high"]},
            "word_count": {"type": "integer", "minimum": 0},
            "equation_lines": {"type": "integer", "minimum": 0},
            "figure_table_refs": {"type": "integer", "minimum": 0},
            "code_lines": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "assessment": {
          "type": "object",
          "required": ["mode", "score_max", "items", "rubric"],
          "properties": {
            "mode": {"const": "self-check"},
            "score_max": {"const": 5},
            "items": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["course_day", "topic", "module", "review_age_days"], "properties": {"course_day": {"type": "integer"}, "topic": {"type": "string"}, "module": {"type": "string"}, "review_age_days": {"type": "integer"}}, "additionalProperties": false}},
            "rubric": {"type": "string"}
          },
          "additionalProperties": false
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["minutes", "activity", "en"],
            "properties": {
              "minutes": {"type": "integer", "minimum": 1},
              "activity": {"type": "string"},
              "en": {"type": "string"},
              "my": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "study_output": {
          "type": "object",
          "required": ["en"],
          "properties": {"en": {"type": "string"}, "my": {"type": "string"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ai_review": {
      "type": "object",
      "required": ["status", "reviewed_at", "reviewer"],
      "properties": {
        "status": {"enum": ["passed", "rejected"]},
        "reviewed_at": {"type": "string"},
        "reviewer": {"type": "string"},
        "review_id": {"type": "string"}
      }
    },
    "content": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": {"$ref": "#/$defs/richLanguage"},
        "my": {"$ref": "#/$defs/richLanguage"}
      },
      "additionalProperties": false
    }
    ,"review_items": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "properties": {"question": {"type": "string"}, "answer": {"type": "string"}}
      }
    },
    "active_exercise": {
      "type": "object",
      "required": ["instruction", "output"],
      "properties": {"instruction": {"type": "string"}, "output": {"type": "string"}},
      "additionalProperties": false
    }
  },
  "$defs": {
    "richLanguage": {
      "type": "object",
      "required": ["title", "learning_objective", "simple_explanation", "how_it_works", "visual", "use_case", "expected_result", "what_to_notice", "common_mistake", "practical_tip", "question", "answer"],
      "properties": {
        "title": {"type": "string"},
        "learning_objective": {"type": "string", "minLength": 30, "maxLength": 220},
        "simple_explanation": {"type": "string", "minLength": 140, "maxLength": 650},
        "how_it_works": {"type": "string"},
        "visual": {"type": "string", "minLength": 20, "maxLength": 500},
        "use_case": {"type": "string"},
        "expected_result": {"type": "string", "minLength": 50, "maxLength": 450},
        "what_to_notice": {"type": "string", "minLength": 60, "maxLength": 450},
        "common_mistake": {"type": "string"},
        "practical_tip": {"type": "string"},
        "question": {"type": "string"},
        "answer": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"language": {"enum": ["en", "bilingual"]}}},
      "then": {"required": ["content"]},
      "else": {"required": ["title", "summary", "explanation", "use_case", "question", "answer"]}
    }
  ]
}
